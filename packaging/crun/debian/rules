#!/usr/bin/make -f
%:
	dh $@ --with autoreconf

# Upstream ships a GNUmakefile whose default target aborts when no
# configured Makefile exists yet; only run distclean if configured.
override_dh_auto_clean:
	if test -f Makefile; then $(MAKE) distclean; fi
	dh_autoreconf_clean

# Delete .la files: they cause lintian non-empty-dependency_libs-in-la-file
# errors and are not needed on modern systems.
override_dh_install:
	dh_install
	find debian/crun -name "*.la" -delete

# Skip dbgsym generation (not needed for our APT repo; avoids lintian
# skipping .changes when the .ddeb is missing).
override_dh_strip:
	dh_strip --no-automatic-dbgsym
