#!/usr/bin/make -f
# Install the canonical default config files by explicit path. A blind
# `find` picks up test fixtures (e.g. libimage/testdata/containers.conf)
# that share basenames with the real files.
%:
	dh $@

override_dh_auto_build:
	: nothing to compile

override_dh_auto_install:
	mkdir -p debian/containers-common/etc/containers
	install -D -m0644 pkg/config/containers.conf \
		debian/containers-common/etc/containers/containers.conf
	install -D -m0644 pkg/seccomp/seccomp.json \
		debian/containers-common/etc/containers/seccomp.json
	install -D -m0644 rpm/policy.json \
		debian/containers-common/etc/containers/policy.json
	# No canonical registries.conf ships in common/; tests/registries.conf
	# is the sane default (docker.io, quay.io search registries).
	install -D -m0644 tests/registries.conf \
		debian/containers-common/etc/containers/registries.conf
