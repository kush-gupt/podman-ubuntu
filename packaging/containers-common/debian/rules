#!/usr/bin/make -f
# Upstream's config files move around between releases; install whatever
# known config filenames exist in the tree rather than hardcoding paths.
%:
	dh $@

override_dh_auto_build:
	: nothing to compile

override_dh_auto_install:
	mkdir -p debian/containers-common/etc/containers
	for f in $$(find . -path ./debian -prune -o \
		\( -name 'containers.conf' -o -name 'registries.conf' \
		-o -name 'policy.json' -o -name 'storage.conf' \
		-o -name 'seccomp.json' \) -print | grep -v vendor); do \
		install -D -m0644 "$$f" \
			"debian/containers-common/etc/containers/$$(basename $$f)"; \
	done
	test -n "$$(ls debian/containers-common/etc/containers/)"
