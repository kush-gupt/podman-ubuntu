#!/usr/bin/make -f
# Crate sources are vendored by scripts/prepare-source.sh (cargo vendor);
# the sbuild itself runs fully offline.
include debian/common/rust.mk
include debian/common/rules.mk

%:
	dh $@

override_dh_auto_build:
	$(MAKE) build

override_dh_auto_install:
	$(MAKE) PREFIX=/usr DESTDIR=debian/netavark install

# netavark 1.x programs the firewall via iptables; 2.x moved to nftables.
# Depend on the backend matching the major version being built.
FIREWALL_BACKEND := $(shell dpkg-parsechangelog -S Version 2>/dev/null | grep -q '^1\.' && echo iptables || echo nftables)
override_dh_gencontrol:
	dh_gencontrol -- -Vnetavark:firewall=$(FIREWALL_BACKEND)
